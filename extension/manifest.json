{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.9.9",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_TW",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "cookies",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.threads.com/*",
    "*://*.threads.net/*",
    "*://*.instagram.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.twimg.com/*",
    "*://*.fbcdn.net/*",
    "*://*.fbsbx.com/*",
    "*://*.cdninstagram.com/*",
    "https://studio.milkcat.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*", "https://studio.milkcat.org/*"],
      "js": ["i18n.js", "content.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.threads.com/*",
        "*://*.threads.net/*",
        "*://*.instagram.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*"
      ],
      "js": ["i18n.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://*.facebook.com/*"]
    }
  ]
}
